{
  "expo": {
    "name": "DesMov-Grupo31",
    "slug": "DesMov-Grupo31",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "desmovgrupo31",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.grupo31.reporteciudadano",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.grupo31.reporteciudadano",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3F99D5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-vector-icons/ionicons",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Reporte Ciudadano usa tu ubicación para marcar dónde está el problema que reportás y mostrarte qué hay cerca."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "070af8d5-ffb7-4c9d-b5c4-0fe234ba3697"
      }
    },
    "owner": "yangcr"
  }
}
