# Variables de entorno de Reporte Ciudadano. Copiá este archivo a `.env` y completalo:
#
#   cp .env.example .env
#
# `.env` está en .gitignore y nunca se sube. Después de cambiar algo: `npx expo start --clear`.
#
# Sólo las variables con prefijo EXPO_PUBLIC_ llegan al código JavaScript, y sólo si se leen
# de forma estática (`process.env.EXPO_PUBLIC_API_URL`, nunca con corchetes ni destructuración).
# Quedan en texto plano dentro de la app: nada secreto va con ese prefijo.

# URL base de la API de la cátedra (api-proyectos-mobile/api-reporte-ciudadano).
# Corriendo en Docker en una compu de la red: la IP LAN de esa compu, no "localhost" (en el
# teléfono, localhost es el propio teléfono). Para probar que llega: abrí <URL>/salud en el
# navegador del teléfono. La API publicada del grupo: https://api-desmov.yangcr.com
EXPO_PUBLIC_API_URL=https://api-desmov.yangcr.com

# Tiempo máximo de cada pedido a la API, en milisegundos.
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Con "true" la app no usa la API: los servicios responden con los datos de src/mocks.
# Contraseña de todas las cuentas: demo1234.
#   En los dos modos:  norma@mail.com, operador.norte@demo.ar, operador.sur@demo.ar
#   Sólo en mocks:     martin@demo.ar (en la API existe con otro id), ana@demo.ar,
#                      operador.este@demo.ar, operador.oeste@demo.ar
EXPO_PUBLIC_USAR_MOCKS=false

# Clave de Google Maps para Android (en iOS el mapa es Apple Maps y no pide clave).
# La lee app.config.ts al armar la app y va al manifiesto de Android: no lleva EXPO_PUBLIC_.
# Consola de Google Cloud: habilitar "Maps SDK for Android". Cambiarla exige recompilar el APK.
# EAS Build no sube .env: ya está cargada en EAS para los perfiles development y preview.
GOOGLE_MAPS_API_KEY=

# La API no usa clave: la sesión es un token que devuelve POST /auth/ingreso y se guarda con
# expo-secure-store.
