# =============================================================================
# DesMov - Grupo 31
# Plantilla de variables de entorno
# =============================================================================
#
# CÓMO USARLO
#   1. Copia este archivo a ".env":
#        cp .env.example .env      (Linux / macOS / Git Bash)
#        copy .env.example .env    (Windows CMD / PowerShell)
#
#   2. Rellena los valores de ejemplo con los reales.
#   3. Reinicia el servidor:  npx expo start --clear
#
#   ".env" esta en .gitignore  ->  NUNCA se sube al repositorio.
#   ".env.example" SI se versiona  ->  es la plantilla de referencia.
#   Al hacer commit, revisa que nunca se te cuele un ".env" con secretos reales.
#
# -----------------------------------------------------------------------------
# REGLAS IMPORTANTES
# -----------------------------------------------------------------------------
#
# 1. Toda variable que quieras usar dentro del codigo DEBE empezar por
#    el prefijo  EXPO_PUBLIC_ .  Sin ese prefijo Expo no la expone a la app.
#
# 2. Solo se admite acceso estatico con notacion de punto:
#        const url = process.env.EXPO_PUBLIC_API_URL;            Correcto
#        const url = process.env['EXPO_PUBLIC_API_URL'];        Incorrecto
#        const { EXPO_PUBLIC_API_URL } = process.env;            Incorrecto
#
# 3. NO guardes datos sensibles (claves privadas, tokens, contrasenas,
#    refresh tokens) en variables EXPO_PUBLIC_: quedan escritas en texto
#    plano dentro del bundle de la app y cualquier usuario puede leerlas.
#    Para datos sensibles usa expo-secure-store.
#
# 4. Los archivos admitidos son .env, .env.local, .env.development y
#    .env.production. Si varias coinciden, gana .env.local sobre .env,
#    y .env.local sobre los demas.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Entorno de ejecucion
# -----------------------------------------------------------------------------
# Valores posibles: development | staging | production
# Util para mostrar banners de debug o cambiar endpoints segun el entorno.
EXPO_PUBLIC_APP_ENV=development


# -----------------------------------------------------------------------------
# Backend / API REST
# -----------------------------------------------------------------------------
# URL base de la API de Reporte Ciudadano (api-proyectos-mobile/api-reporte-ciudadano).
# Corriendo en Docker en una compu de la red: usa la IP LAN de esa compu, NO
# "localhost" (en el telefono, localhost es el propio telefono).
# Publicada (Render, etc.): la URL https:// del servicio.
# Para probar que llega: abri <URL>/salud en el navegador del telefono.
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Con "true" la app no usa la API: los servicios responden con los datos de src/mocks.
# Util para probar sin backend. Los datos de los mocks NO son los de la API: siguen los
# ejemplos del PDF. Contrasena de todas las cuentas: demo1234.
#   En los dos modos:  norma@mail.com, operador.norte@demo.ar, operador.sur@demo.ar
#   Solo en mocks:     martin@demo.ar (en la API existe con otro id), ana@demo.ar,
#                      operador.este@demo.ar, operador.oeste@demo.ar
EXPO_PUBLIC_USAR_MOCKS=false

# La API no usa clave: la sesion es un token que devuelve POST /auth/ingreso
# y se guarda con expo-secure-store (nunca en una variable EXPO_PUBLIC_).


# -----------------------------------------------------------------------------
# Servicios externos (descomenta los que uses)
# -----------------------------------------------------------------------------

# Autenticacion
# EXPO_PUBLIC_AUTH_DOMAIN=
# EXPO_PUBLIC_AUTH_CLIENT_ID=
# EXPO_PUBLIC_AUTH_AUDIENCE=

# Supabase
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Firebase
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# Sentry (monitoreo de errores)
# EXPO_PUBLIC_SENTRY_DSN=

# Google Maps
# EXPO_PUBLIC_MAPS_API_KEY=

# Notificaciones push (token de Expo Push Notifications)
# EXPO_PUBLIC_EAS_PROJECT_ID=


# -----------------------------------------------------------------------------
# Comportamiento de la app
# -----------------------------------------------------------------------------
# Muestra herramientas de desarrollo (pantalla de debug, logs extra).
EXPO_PUBLIC_ENABLE_DEV_TOOLS=true

# Tiempo de espera de las peticiones a la API, en milisegundos.
EXPO_PUBLIC_API_TIMEOUT_MS=10000
